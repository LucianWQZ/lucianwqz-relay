+    saved = tmp_path / "mrv2-lifecycle.json"
+    saved.write_text(json.dumps(dict(identity=doc["identity"], records=records)))
+    campaign = dict(diagnostic_artifacts={saved.name: dict(bytes=saved.stat().st_size, sha256=digest(saved))})
+    launcher = dict(host_start_ns=0, host_end_ns=10**30)
+    assert tool.check(doc, campaign, launcher, {}, path)["status"] == "PASS_SCOPED_NATIVE_JSON_COLLECTION"
+    assert tool.check(doc, campaign, launcher, {}, path, native_bindings=True)["status"] == "INVALID_EVIDENCE"
+
+
+def test_poisoned_life_never_reads_capture_parameters(monkeypatch, tmp_path):
+    def forbidden():
+        raise AssertionError("must not inspect uncertain native/capture state")
+
+    monkeypatch.setattr(tool, "_captured_parameters", forbidden)
+    with pytest.raises(ValueError):
+        tool.completed_graph_dump(SimpleNamespace(), SimpleNamespace(poisoned=True),
+                                  tmp_path / "task-dump-index.json", {}, host_bindings=True)
+    assert not list(tmp_path.iterdir())
+
+
+@pytest.mark.parametrize("ambiguous", [False, True])
+def test_native_layer_match_is_by_kv_pair_not_task_order(tmp_path, ambiguous):
+    spec, params, capture = binding_fixture()
+    a = tool.capture_fia_bindings(spec, SimpleNamespace(num_tokens=7), params, [capture])[0]
+    import copy
+    b = copy.deepcopy(a)
+    b.update(layer_name="layer1", handle_identity=a["handle_identity"] + 1, event_identity=a["event_identity"] + 1)
+    b["key"][0]["data_ptr"] += 8
+    b["value"][0]["data_ptr"] += 8
+    for x in (a, b):
+        x["host_observed_ns"] = 2
+    cap_b = dict(capture, layer_name="layer1", handle_identity=b["handle_identity"], event_identity=b["event_identity"])
+    updates = [dict(x, stage="update_operator", generation_id=6, mapping_epoch=6, length_values=[28]) for x in (capture, cap_b)]
+    life = dict(draft_layer_names=["layer0", "layer1"], recorder=dict(operand_events=[capture, cap_b, *updates]))
+    second = native(key=0x30008, value=0x40008)
