+    doc = dict(schema="repair8-native-graph-json-v2", host_binding_scope="AFTER_SUCCESSFUL_LIFE_DRAINS_METADATA_ONLY",
+               identity=dict(process_id=123), records=[dict(descriptor=[1, 7], captured_fia_bindings=[a, b],
+               path=path.name, last_life_generation=6, last_life_epoch=6, start_ns=1, end_ns=3)])
+    if ambiguous:
+        b["key"], b["value"] = a["key"], a["value"]
+        with pytest.raises(ValueError):
+            tool.native_parameter_bindings(doc, life, tmp_path / "index.json")
+    else:
+        result = tool.native_parameter_bindings(doc, life, tmp_path / "index.json")
+        assert [r["layer_name"] for r in result["tasks"]] == ["layer1", "layer0"]
