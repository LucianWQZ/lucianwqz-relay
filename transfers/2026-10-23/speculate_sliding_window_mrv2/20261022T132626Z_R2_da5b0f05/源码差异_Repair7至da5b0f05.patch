+    with probe:
+        probe.begin_active()
+        with owner._draft_window_proposal_scope(batch, dummy_run=False, is_profile=False):
+            inputs = owner._materialize_draft_window_read_inputs(num_reqs=2, num_reqs_padded=4)
+            owner._draft_window_live_inputs = inputs
+    result = json.loads(path.read_text())
+    assert result["materialize_subranges"] is nested
+    assert owner._draft_window_runtime_state.workspace.storage_pointers == pointer
+    assert not probe.saved and not probe.call_stack
+    assert "_snapshot_prepared_draft_seq_lens" not in vars(owner)
+    total = next(c for c in result["calls"] if c["label"] == "Draft_materialize")
+    children = [c for c in result["calls"] if c["label"].startswith("Draft_materialize_")]
+    if nested:
+        assert {c["label"] for c in children} == {
+            "Draft_materialize_exact_length_snapshot", "Draft_materialize_epoch_validate",
+            "Draft_materialize_runtime", "Draft_materialize_workspace", "Draft_materialize_build_inputs"
+        }
+        assert len({c["call_id"] for c in result["calls"]}) == len(result["calls"])
+        assert all(total["start_ns"] <= c["start_ns"] < c["end_ns"] <= total["end_ns"] for c in children)
+        assert all(c["proposal_context_id"] == total["proposal_context_id"] for c in children)
+        assert all(c["proposal_mapping_epoch"] == total["proposal_mapping_epoch"] for c in children)
+        runtime = next(c for c in children if c["label"] == "Draft_materialize_runtime")
+        workspace = next(c for c in children if c["label"] == "Draft_materialize_workspace")
+        assert workspace["parent_call_id"] == runtime["call_id"]
+    else:
+        assert not children and "call_id" not in total
