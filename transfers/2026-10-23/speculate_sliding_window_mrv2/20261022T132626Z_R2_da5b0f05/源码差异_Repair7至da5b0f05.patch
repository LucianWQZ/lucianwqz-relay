+# SPDX-License-Identifier: Apache-2.0
+"""CANN9.1 observed folded-layout contract; synthetic addresses, no device.
+
+The relocation positions/list header are taken from the C15 native JSON format.
+These tests do not assert that synthetic layer labels were observed on an NPU.
+"""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tools import p7x_graph_repair8_task_dump as tool
+
+
+def native(requests=1, key=0x30000, value=0x40000):
+    words = [0] * (368 + 2 * requests)
+    data = {0: 37, 1: 353, 2: 359, 3: 365, 4: 365 + requests}
+    addr = {0: 35, 1: 2, 2: 3, 3: 6, 4: 7}
+    labels = {}
+    for i in data:
+        words[addr[i]] = 0x900000 + data[i] * 8
+        labels[addr[i]], labels[data[i]] = f"(placeHolderAddr{i})", f"(placeHolderData{i})"
+    words[1], words[15], words[32] = 0x10000, 0x20000, 0x50000
+    words[353:359] = [40, 0x100000003, 8, 128, 1024, key]
+    words[359:365] = [40, 0x100000003, 8, 128, 1024, value]
+    words[365:365 + requests] = [7 * (i + 1) for i in range(requests)]
+    words[365 + requests:365 + 2 * requests] = [28] * requests
+    return dict(name=tool.FIA_KERNEL, pid="123 aclGraph", args={
+        "Kernel Args": " ".join(labels.get(i, "") + f"0x{v:016x}" for i, v in enumerate(words)),
+        "Task Type": "KERNEL_MIX_AIC", "Kernel Args Size": len(words) * 8, "Model Id": 45, "Stream Id": 9, "Task Id": 16})
+
+
+@pytest.mark.parametrize("requests", [1, 2, 4])
+def test_observed_relocation_and_list_layout(requests):
+    d = tool.decode_native_fia(native(requests), requests)
+    assert d["argument_block_base"] == 0x900000
+    assert d["key"] == dict(data_ptr=0x30000, shape=[8, 128, 1024])
+    assert d["value"]["data_ptr"] == 0x40000
+    assert d["table_ptr"] == 0x20000
+    assert d["query_lengths"] == [7 * (i + 1) for i in range(requests)]
+    assert d["kv_lengths"] == [28] * requests
+
+
+@pytest.mark.parametrize("damage", ["size", "extra_bytes", "duplicate_label", "relocation", "kernel", "list_header"])
+def test_native_layout_damage_rejected(damage):
+    e = native()
+    if damage == "size":
+        e["args"]["Kernel Args Size"] += 8
+    elif damage == "extra_bytes":
+        e["args"]["Kernel Args"] += " corrupted"
+    elif damage == "duplicate_label":
+        e["args"]["Kernel Args"] += " (placeHolderData0)0x0000000000000000"
+    elif damage == "relocation":
+        e["args"]["Kernel Args"] = e["args"]["Kernel Args"].replace("0x0000000000900128", "0x0000000000900130")
+    elif damage == "kernel":
+        e["name"] = "OtherKernel"
+    else:
+        e["args"]["Kernel Args"] = e["args"]["Kernel Args"].replace("(placeHolderData1)0x0000000000000028", "(placeHolderData1)0x0000000000000020")
+    with pytest.raises(ValueError):
+        tool.decode_native_fia(e, 1)
+
+
+class MetadataOnlyTensor:
+    def __init__(self, pointer, shape, dtype="torch.bfloat16"):
+        self.pointer, self.shape, self.dtype, self.device = pointer, shape, dtype, "npu:0"
+
+    def data_ptr(self):
+        return self.pointer
+
+    def __getitem__(self, key):
+        raise AssertionError("must not index device tensor")
+
+    def __len__(self):
+        raise AssertionError("must not treat device tensor as a sequence")
+
+    def __iter__(self):
+        raise AssertionError("must not iterate device tensor")
+
+    def to(self, *args, **kwargs):
+        raise AssertionError("must not copy/synchronize device tensor")
+
+
+def binding_fixture():
+    handle, event = object(), object()
+    param = [None] * 22
+    param[0] = MetadataOnlyTensor(0x10000, [7, 32, 128])
+    # Match full_graph_fia + pinned weak_ref_tensors: retain single Tensors.
+    param[1] = MetadataOnlyTensor(0x30000, [8, 128, 1024])
+    param[2] = MetadataOnlyTensor(0x40000, [8, 128, 1024])
+    param[3] = MetadataOnlyTensor(0x20000, [1, 32], "torch.int32")
+    param[6], param[7] = [1151], [7]
+    param[11] = MetadataOnlyTensor(0x50000, [7, 32, 128])
+    # Generic DSpark capture tuple has no layer-aware name; use explicit IDs.
+    params = SimpleNamespace(attn_params={7: [tuple(param)]}, handles={7: [handle]}, events={7: [event]})
+    observed = dict(stage="capture_operator", num_tokens=7, handle_identity=id(handle),
+                    event_identity=id(event), layer_name="layer0", actual_table_address=0x20000,
+                    length_values=[1151])
