new file mode 100644
index 000000000..49db71af1
--- /dev/null
+++ b/tools/p7x_graph_local_candidate.py
@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Audited local-commit plan and per-case device binding for Repair7 descendants.
+
+This path never represents a local commit as a verified remote publication.
+Preparation is Host only. Binding still requires the committed device receipt
+validator and a fresh receipt for the selected case.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+if __name__ == "__main__":
+    sys.path[:] = [p for p in sys.path if Path(p or ".").resolve() != Path(__file__).parent.resolve()]
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+BASE_SHA = "7a9f4aae1ebe5c5f3d4876ec9b49926949dfae14"
+VLLM_SHA = "84030bbe3d74d99bad477a3d2e37a973ccd8865c"
+VLLM_TREE = "f3e320f8ae2e9a30e57a3c8dccfac94fcae93bee"
+FIXTURE_SHA = "1c485bc43a6e8f6d0d83c1dc6ebfd0fb9bb1f31a8ad9e498ef1d3e9d562e7cd4"
+STATUS = "LOCAL_COMMITTED_CANDIDATE"
+
+
+def digest(path: Path) -> str:
+    sha = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(4 << 20), b""):
+            sha.update(block)
+    return sha.hexdigest()
+
+
+def _git(repo: Path, *args: str) -> str:
+    return subprocess.check_output(["git", "-C", str(repo), *args], text=True).strip()
+
+
+def _identity(repo: Path, sha: str, tree: str, *, ancestor: str | None = None) -> None:
+    if _git(repo, "rev-parse", "HEAD") != sha or _git(repo, "rev-parse", "HEAD^{tree}") != tree:
+        raise ValueError("local candidate commit/tree mismatch")
+    if _git(repo, "status", "--porcelain", "--untracked-files=all"):
+        raise ValueError("local candidate checkout is dirty")
+    if ancestor is not None:
+        subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor", ancestor, sha], check=True)
+
+
+def _cases_sha(plan: dict) -> str:
+    return hashlib.sha256(json.dumps(plan["cases"], sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def _validate_host_evidence(evidence: list[dict]) -> None:
+    if not evidence or any(
+        row.get("status") != "PASS" or digest(Path(row["path"])) != row["sha256"] for row in evidence
+    ):
+        raise ValueError("Host evidence missing or changed")
+    required = {"graph_quarantine", "local_admission"}
+    if not required.issubset({row.get("label") for row in evidence}):
+        raise ValueError("Host evidence coverage missing")
+
+
+def validate_local_plan(plan: dict) -> dict:
+    if plan.get("publication_status") != STATUS or plan.get("remote_publication") != "NOT_PERFORMED":
+        raise ValueError("not a local committed candidate plan")
+    if plan.get("schema") != "repair7-case-plan-v1":
+        raise ValueError("local candidate requires Repair7 case schema")
+    if not plan.get("local_candidate_manifest") or not plan.get("local_candidate_manifest_sha256"):
+        raise ValueError("local candidate manifest missing")
+    path = Path(plan["local_candidate_manifest"])
+    if digest(path) != plan["local_candidate_manifest_sha256"]:
+        raise ValueError("local candidate manifest changed")
+    manifest = json.loads(path.read_text())
+    if manifest.get("schema") != "repair7-local-candidate-v1":
+        raise ValueError("unknown local candidate manifest")
+    if (manifest.get("source_sha"), manifest.get("source_tree"), manifest.get("run_id")) != (
+        plan["commit"], plan["tree"], plan["run_id"]
+    ):
+        raise ValueError("local manifest/source/run mismatch")
+    if manifest.get("baseline_sha") != BASE_SHA or manifest.get("cases_sha256") != _cases_sha(plan):
+        raise ValueError("local baseline or cases changed")
+    repo = Path(manifest["source_checkout"])
+    vllm = Path(manifest["vllm_checkout"])
+    _identity(repo, plan["commit"], plan["tree"], ancestor=BASE_SHA)
+    _identity(vllm, VLLM_SHA, VLLM_TREE)
+    if manifest.get("vllm_sha") != VLLM_SHA or manifest.get("vllm_tree") != VLLM_TREE:
+        raise ValueError("vLLM pin changed")
+    for rel, expected in manifest["source_files_sha256"].items():
+        if digest(repo / rel) != expected:
+            raise ValueError("local source file changed: " + rel)
+    fixture = Path(manifest["fixture_manifest"])
+    if digest(fixture) != FIXTURE_SHA:
+        raise ValueError("fixture manifest changed")
+    expected_files = json.loads(fixture.read_text())["files"]
+    verified_files = manifest.get("fixture_files", [])
+    if len(expected_files) != len(verified_files):
+        raise ValueError("fixture verification count changed")
+    for expected, verified in zip(expected_files, verified_files):
+        path = Path(expected["path"])
+        stat = path.stat()
+        if (verified.get("path"), verified.get("sha256"), verified.get("size"), verified.get("mtime_ns")) != (
+            str(path), expected["sha256"], stat.st_size, stat.st_mtime_ns
+        ):
+            raise ValueError("fixture changed since prepare: " + str(path))
+    config_path = Path(manifest["config_report"])
+    if digest(config_path) != manifest["config_report_sha256"]:
+        raise ValueError("local config report changed")
+    config = json.loads(config_path.read_text())
+    if config.get("status") != "CONFIGS_VALID" or not config.get("rows") or any(
+        row.get("status") != "SCHEMA_VALID_NOT_FRAMEWORK_PASS" for row in config["rows"]
+    ):
+        raise ValueError("local schema check did not pass")
+    if {row.get("numeric_enabled") for row in config["rows"]} != {False, True}:
+        raise ValueError("local schema check lacks enabled and disabled diagnostic cases")
+    evidence = manifest.get("host_evidence", [])
+    _validate_host_evidence(evidence)
+    return {
+        "status": STATUS,
+        "source_sha": plan["commit"],
+        "source_tree": plan["tree"],
+        "device_validation": "NOT_INFERRED",
+    }
+
+
+def prepare(args: argparse.Namespace) -> None:
+    from tools.p7x_graph_repair7 import config_matrix
+    from tools.p7x_graph_repair7_campaign import build_plan
+
+    if args.output.exists():
+        raise ValueError("new local candidate output directory required")
+    sha, tree = _git(args.repo, "rev-parse", "HEAD"), _git(args.repo, "rev-parse", "HEAD^{tree}")
+    _identity(args.repo, sha, tree, ancestor=BASE_SHA)
+    _identity(args.vllm, VLLM_SHA, VLLM_TREE)
+    fixture = args.inputs / "fixture_manifest.json"
+    if digest(fixture) != FIXTURE_SHA:
+        raise ValueError("fixture manifest mismatch")
+    verified_files = []
+    for row in json.loads(fixture.read_text())["files"]:
+        path = Path(row["path"])
+        stat = path.stat()
+        if digest(path) != row["sha256"]:
+            raise ValueError("fixture file changed: " + str(path))
+        verified_files.append(
+            {"path": str(path), "sha256": row["sha256"], "size": stat.st_size, "mtime_ns": stat.st_mtime_ns}
+        )
+    host_evidence = json.loads(args.host_evidence.read_text())
+    _validate_host_evidence(host_evidence)
+    plan = build_plan(args.repo, args.inputs, args.output, args.vllm, sys.executable, sha, tree, args.run_id)
+    config = config_matrix(plan, framework=False)
+    if config.get("status") != "CONFIGS_VALID":
+        raise ValueError("local schema configuration failed: " + config.get("status", "UNKNOWN"))
+    args.output.mkdir(parents=True)
+    config_path = args.output / "config-schema.json"
+    config_path.write_text(json.dumps(config, indent=2) + "\n")
+    source_files = [
+        "tools/p7x_graph_local_candidate.py",
+        "tools/p7x_graph_repair6_runner.py",
+        "tools/p7x_graph_repair7_device.py",
+        "tools/p7x_graph_repair7_campaign.py",
+        "tools/p7x_graph_repair8_unwind.py",
+        "tools/p7x_graph_repair8_task_dump.py",
+        "tools/p7x_graph_repair5_profile.py",
+        "tools/p7x_graph_repair5_evidence.py",
+        "tools/p7x_graph_repair7.py",
+        "tools/p7x_graph_repair2.py",
+        "vllm_ascend/worker/v2/spec_decode/draft_window.py",
+        "vllm_ascend/worker/v2/spec_decode/draft_window_eager.py",
+    ]
+    manifest = {
+        "schema": "repair7-local-candidate-v1",
+        "source_checkout": str(args.repo.resolve()),
+        "source_sha": sha,
+        "source_tree": tree,
+        "baseline_sha": BASE_SHA,
+        "vllm_checkout": str(args.vllm.resolve()),
+        "vllm_sha": VLLM_SHA,
+        "vllm_tree": VLLM_TREE,
+        "run_id": args.run_id,
+        "cases_sha256": _cases_sha(plan),
+        "source_files_sha256": {rel: digest(args.repo / rel) for rel in source_files},
+        "fixture_manifest": str(fixture.resolve()),
+        "fixture_files": verified_files,
+        "config_report": str(config_path.resolve()),
+        "config_report_sha256": digest(config_path),
+        "host_evidence": host_evidence,
+        "remote_publication": "NOT_PERFORMED",
+        "device_validation": "NOT_RUN",
+    }
+    manifest_path = args.output / "local-candidate-manifest.json"
+    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
+    plan.update(
+        publication_status=STATUS,
+        remote_publication="NOT_PERFORMED",
+        local_candidate_manifest=str(manifest_path.resolve()),
+        local_candidate_manifest_sha256=digest(manifest_path),
+        readiness="HOST_PREPARED; fresh per-case device receipt still required",
+    )
+    plan_path = args.output / "case-plan.json"
+    plan_path.write_text(json.dumps(plan, indent=2) + "\n")
+    validate_local_plan(plan)
+
+
+def bind(args: argparse.Namespace) -> None:
+    from tools.p7x_graph_repair7_device import validate_admission
+
+    if args.output.exists():
+        raise ValueError("new admitted plan output required")
+    plan = json.loads(args.plan.read_text())
+    validate_local_plan(plan)
+    if args.case_id not in plan["cases"] or not plan["cases"][args.case_id].get("requires_device_admission"):
+        raise ValueError("case does not require device binding")
+    plan.update(device_admission_receipt=str(args.receipt.resolve()), device_admission_sha256=digest(args.receipt))
+    validate_admission(plan, args.case_id)
+    args.output.write_text(json.dumps(plan, indent=2) + "\n")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    p = sub.add_parser("prepare")
+    for name in ("repo", "vllm", "inputs", "output", "host-evidence"):
+        p.add_argument("--" + name, type=Path, required=True)
+    p.add_argument("--run-id", required=True)
+    b = sub.add_parser("bind")
+    for name in ("plan", "receipt", "output"):
+        b.add_argument("--" + name, type=Path, required=True)
+    b.add_argument("--case-id", required=True)
+    args = parser.parse_args()
+    (prepare if args.command == "prepare" else bind)(args)
+
+
+if __name__ == "__main__":
+    main()
