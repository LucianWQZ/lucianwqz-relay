+    campaign = dict(identity=identity, startup_complete=True, status="EXCEPTION",
+                    exception_type="InjectedGraphUnwindError", exception_message="REPAIR8_PYTHON_UNWIND:after_replay",
+                    request_manifest=dict(sha256="c" * 64), diagnostic_quarantine="PROCESS_EXIT_74_NO_REUSE")
+    if damage == "pid":
